{
  "name": "@vasakgroup/vue-libvasak",
  "version": "0.2.3",
  "description": "Vue componenets for VSK Applications",
  "main": "./dist/vue-libvasak.umd.js",
  "module": "./dist/vue-libvasak.es.js",
  "types": "src/types/vue-libvasak.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/types/vue-libvasak.d.ts",
      "import": "./dist/vue-libvasak.es.js",
      "require": "./dist/vue-libvasak.umd.js",
      "default": "./dist/vue-libvasak.es.js"
    },
    "./style.css": "./dist/vue-libvasak.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "vue",
    "vsk",
    "vasak",
    "components",
    "ui",
    "window",
    "vasakos",
    "vasakgroup",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasak-os/vue-libvasak.git"
  },
  "homepage": "https://github.com/vasak-os/vue-libvasak#readme",
  "bugs": {
    "url": "https://github.com/vasak-os/vue-libvasak/issues",
    "email": "os@vasak.net.ar"
  },
  "author": {
    "name": "Joaquin (Pato) Decima",
    "email": "jdecima@vasak.net.ar",
    "url": "https://joaquindecima.gitlab.io/"
  },
  "license": "GPLv3",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@vasakgroup/plugin-vicons": "^2.0.0",
    "vue": "^3.5.28",
    "vue-router": "^5.0.3"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "@vitejs/plugin-vue": "^6.0.4"
  },
  "scripts": {
    "build": "bunx --bun vite build",
    "dev": "bunx --bun vite",
    "prepare": "bun run build"
  }
}
